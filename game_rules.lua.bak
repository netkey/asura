local nk = require("nakama")
local M = {}

-- ==========================================
-- 1. 卡牌效果定义 (易扩展模式)
-- ==========================================

local CARD_EFFECTS = {
    -- 【攻击】逻辑
    ["ATTACK"] = function(dispatcher, state, source_id, target_id)
        local hero_mgr = require("hero_manager")
        local target = state.players[target_id]
        
        -- 1. 触发攻击前钩子 (预留：比如有的英雄攻击伤害+1)
        hero_mgr.trigger("on_before_attack", dispatcher, state, source_id, target_id)

        -- 2. 检查对方是否有“防御”牌 (蜃景)
        local defense_idx = nil
        for i, c in ipairs(target.hand) do
            if c.type == "DEFENSE" then defense_idx = i; break end
        end

        if defense_idx then
            -- 对方有防御牌，触发“被抵挡”钩子 (这就是阿里巴巴“暗号”技能的传感器)
            -- 我们告诉 hero_manager：有人发起了攻击但被挡住了
            local suspended = hero_mgr.trigger("on_attack_defended", dispatcher, state, source_id, target_id)
            
            -- 如果没有任何英雄技能要打断流程（阿里巴巴没发动或者不是阿里巴巴）
            if not suspended then
                local def_card = table.remove(target.hand, defense_idx)
                table.insert(state.discard_pile, def_card)
                nk.logger_info(target.username .. " 使用了防御牌抵挡了攻击")
            end
        else
            -- 对方没有防御牌，执行伤害
            M.apply_damage(dispatcher, state, target_id, 1, source_id)
        end
    end,

    -- 【治疗】逻辑
    ["HEAL"] = function(dispatcher, state, source_id)
        local hero_mgr = require("hero_manager")
        local p = state.players[source_id]
        
        -- 触发治疗前钩子
        hero_mgr.trigger("on_before_heal", dispatcher, state, source_id)
        
        if p.health < 4 then
            p.health = p.health + 1
            nk.logger_info(p.username .. " 使用了椰枣，恢复血量")
        end
    end,

    -- 【全场伤害】锦囊逻辑
    ["AOE_SANDSTORM"] = function(dispatcher, state, source_id)
        local hero_mgr = require("hero_manager")
        nk.logger_info("沙尘暴来袭！")
        
        for uid, p in pairs(state.players) do
            if uid ~= source_id and p.health > 0 then
                -- 每一发伤害前都可能触发某些英雄的被动技能
                local suspended = hero_mgr.trigger("on_aoe_target", dispatcher, state, uid, source_id)
                
                if not suspended then
                    M.apply_damage(dispatcher, state, uid, 1, source_id)
                end
            end
        end
    end
}

-- ==========================================
-- 2. 牌堆初始化 (中东本土化)
-- ==========================================
function M.create_deck()
    local deck = {}
    -- 基础牌
    for i = 1, 20 do table.insert(deck, {id = "atk_"..i, type = "ATTACK", name = "大马士革弯刀"}) end
    for i = 1, 10 do table.insert(deck, {id = "def_"..i, type = "DEFENSE", name = "蜃景"}) end
    for i = 1, 5 do table.insert(deck, {id = "heal_"..i, type = "HEAL", name = "椰枣"}) end
    -- 锦囊牌
    for i = 1, 3 do table.insert(deck, {id = "aoe_"..i, type = "AOE_SANDSTORM", name = "沙尘暴"}) end
    
    return M.shuffle(deck)
end

function M.shuffle(t)
    for i = #t, 2, -1 do
        local j = math.random(i)
        t[i], t[j] = t[j], t[i]
    end
    return t
end

-- ==========================================
-- 3. 核心出牌逻辑
-- ==========================================
function M.handle_play_card(dispatcher, state, player_id, payload)
    local player = state.players[player_id]
    local card_id = payload.card_id
    local target_id = payload.target_id
    
    -- 寻找并扣除手牌
    local card_idx = nil
    for i, c in ipairs(player.hand) do
        if c.id == card_id then card_idx = i; break end
    end
    
    if card_idx then
        local card = table.remove(player.hand, card_idx)
        table.insert(state.discard_pile, card)
        
        -- 根据卡牌类型触发效果
        if CARD_EFFECTS[card.type] then
            CARD_EFFECTS[card.type](dispatcher, state, player_id, target_id)
        end
        
        M.broadcast_update(dispatcher, state)
        return true
    end
    return false
end

-- ==========================================
-- 4. 伤害与阵亡判定
-- ==========================================
function M.apply_damage(dispatcher, state, target_id, amount, source_id)
    local target = state.players[target_id]
    if not target or target.health <= 0 then return end
    
    -- 1. 执行扣血
    target.health = target.health - amount
    
    -- 2. 【核心修改】触发受到伤害后的钩子
    -- 告诉 hero_manager：target_id 刚才受伤了
    local hero_mgr = require("hero_manager")
    hero_mgr.trigger("on_damaged", dispatcher, state, target_id, amount)

    -- 3. 广播伤害消息给客户端渲染动画
    local msg = { event = "damage", target = target_id, source = source_id, amount = amount }
    dispatcher.broadcast_message(20, nk.json_encode(msg))

    -- 4. 检查阵亡
    if target.health <= 0 then
        target.health = 0
        target.hand = {} -- 弃置所有手牌
        nk.logger_info(target.username .. " 阵亡")
    end
end

-- ==========================================
-- 5. 摸牌与神谕牌逻辑
-- ==========================================
function M.draw_cards(state, player_id, count)
    local player = state.players[player_id]
    for i = 1, count do
        if #state.deck == 0 then
            state.deck = M.shuffle(state.discard_pile)
            state.discard_pile = {}
        end
        if #state.deck > 0 then
            table.insert(player.hand, table.remove(state.deck, 1))
        end
    end
end

function M.pull_oracle(state)
    -- 返回一张特殊的神谕牌
    return { id = "oracle_" .. os.time(), type = "HEAL", name = "精灵的圣水", is_oracle = true }
end

-- ==========================================
-- 6. 状态广播 (带权限过滤)
-- ==========================================
function M.broadcast_update(dispatcher, state)
    for uid, presence in pairs(state.presences) do
        local p_data = state.players[uid]
        local payload = {
            current_turn = state.current_turn_id,
            pending = state.pending_action,
            me = {
                hand = p_data.hand,
                hp = p_data.health
            },
            others = {}
        }
        -- 构建其他玩家的简略信息（不看手牌内容）
        for other_id, other_p in pairs(state.players) do
            if other_id ~= uid then
                table.insert(payload.others, {
                    id = other_id,
                    username = other_p.username,
                    hp = other_p.health,
                    hand_count = #other_p.hand,
                    hero = other_p.hero
                })
            end
        end
        dispatcher.broadcast_message(10, nk.json_encode(payload), {presence})
    end
end

return M
