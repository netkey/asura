# Copy this file to .env and fill in the values before running docker-compose.

# PostgreSQL
POSTGRES_PASSWORD=change_me_in_production

# Nakama
NAKAMA_SERVER_KEY=change_me_in_production

# Apple IAP (required for in-app purchases; leave blank to disable IAP)
APPLE_IAP_SECRET=

# Google Play IAP (required for Android in-app purchases; leave blank to disable)
# Obtain from Google Play Console → Setup → API access → Service account credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
