# Copy this file to .env and fill in the values before running docker-compose.

# PostgreSQL
POSTGRES_PASSWORD=change_me_in_production

# Nakama
NAKAMA_SERVER_KEY=change_me_in_production

# Apple IAP (required for in-app purchases; leave blank to disable IAP)
APPLE_IAP_SECRET=

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
